# orderstock — environment template (safe to commit; no real secrets)
# Copy to .env and fill in a strong SA password for the local Docker SQL Server sandbox.
#
# JDBC-style Prisma connection string (NOT ADO.NET). Reserved chars in the password
# ( : \ = ; / [ ] { } ) must be brace-escaped, e.g. password={Pa:ss;word}.
# SANDBOX ONLY during development — host must be localhost:1433 (the Docker container).
DATABASE_URL="sqlserver://localhost:1433;database=orderstock;user=sa;password=CHANGE_ME_Strong!Passw0rd;encrypt=true;trustServerCertificate=true"

# SA password for the Docker SQL Server sandbox (must match the password in DATABASE_URL
# and meet SQL Server complexity: 8+ chars, upper + lower + digit + symbol).
MSSQL_SA_PASSWORD="CHANGE_ME_Strong!Passw0rd"

# --- ERP read-only connection (erp-dashboards) ---
# SEPARATE, STRICTLY READ-ONLY connection used ONLY by the ERP dashboards. It is a second
# mssql pool, completely independent of DATABASE_URL / Prisma; no ERP table is ever in
# prisma/schema.prisma and no ERP read ever goes through Prisma.
#
# DEV: points at the LOCAL sandbox container, database `erp_fixture` (apply
# db/erp-fixture/00-schema.sql then 01-seed.sql first). Same container as DATABASE_URL,
# DIFFERENT database — never point this at db_TCL from a dev machine.
#
# PRODUCTION: points at db_TCL using the DBA-provisioned SCOPED READ-ONLY login from
# db/create-erp-readonly-login.sql — never `sa`, never `orderstock_app`. The app runs a boot
# permission probe and REFUSES to serve ERP reads if the login can write.
ERP_DATABASE_URL="sqlserver://localhost:1433;database=erp_fixture;user=sa;password=CHANGE_ME_Strong!Passw0rd;encrypt=true;trustServerCertificate=true"

# Optional. Set to 1 to force the read-only boot permission probe to run outside production
# (it always runs in production). Leave unset locally: the sandbox `sa` login legitimately has
# write permissions, so the probe would correctly refuse to start and block local dev.
# ERP_VERIFY_BOOT_PROBE=1

# DANGER / EXPLICIT EXCEPTION — leave UNSET. Set to exactly 1 ONLY to let the ERP pool boot on a
# login that can still WRITE (e.g. the app's existing sa connection to db_TCL) while the scoped
# read-only login is pending. Off by default in EVERY environment, production included; any other
# value keeps the fail-closed refusal. With it on, the boot probe still runs and logs one loud
# warning naming the write permissions found. This is a dated, user-approved, temporary carve-out
# from the program charter — never set it without re-confirming the exception. Remediation: have
# the DBA run db/create-erp-readonly-login.sql, repoint ERP_DATABASE_URL, then unset this.
# See process/context/database/all-database.md -> ERP Read Layer -> charter exception record.
# ERP_ALLOW_WRITE_CAPABLE_LOGIN=1

# --- Auth (next-auth v5 / Auth.js) — Phase 03 ---
# AUTH_SECRET signs the JWT session. Generate with: openssl rand -base64 32
# (v5 name — NOT NEXTAUTH_SECRET). Keep the real value ONLY in .env (gitignored).
AUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_32"
# Required so Auth.js trusts the host in non-Vercel / self-hosted deployments.
AUTH_TRUST_HOST=true
# Initial ADMIN password consumed ONCE by `pnpm tsx prisma/seed.ts`. If unset, the seed
# generates a random one and prints it to stdout for out-of-band delivery. NEVER commit a
# real value here; deliver it securely and change it after first login.
SEED_ADMIN_PASSWORD="CHANGE_ME_initial_admin_password"

# ============================================================================================
# --- PRODUCTION (orderstock.krs.co.th, Docker + caddy-gen) ---
# Values above (sandbox DATABASE_URL + MSSQL_SA_PASSWORD) are DEV-ONLY. In production the app
# points at the customer's EXTERNAL SQL Server; there is no local SQL container. The app serves
# at the DOMAIN ROOT of its own subdomain (no basePath). See docs/deployment-guide-docker.md.
# Fill these on the host at /opt/orderstock/.env (gitignored).
# ============================================================================================

# External SQL Server, database db_TCL. JDBC-style (NOT ADO.NET). Reserved password chars
# ( : \ = ; / [ ] { } ) must be brace-escaped, e.g. password={Pa:ss;word}. Replace <EXTERNAL-HOST>
# and the password; keep database=db_TCL. Login name orderstock_app matches the DB bootstrap script.
# DATABASE_URL="sqlserver://<EXTERNAL-HOST>:1433;database=db_TCL;user=orderstock_app;password={CHANGE_ME_Strong!Passw0rd};encrypt=true;trustServerCertificate=true"

# Signs the JWT session. Generate a fresh value: openssl rand -base64 32. Real value in .env ONLY.
# AUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_32"

# Required so Auth.js trusts the caddy-gen-forwarded host in this self-hosted (non-Vercel) deploy.
# AUTH_TRUST_HOST=true

# AUTH_URL — leave UNSET (recommended) when caddy-gen forwards Host / X-Forwarded-* correctly.
# If set, use the BARE subdomain origin ONLY (the app owns the whole domain root — no path suffix):
# AUTH_URL="https://orderstock.krs.co.th"
